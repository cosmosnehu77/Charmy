# Copiar a .env y completar. El archivo .env está ignorado por git: nunca se sube ni se pega en el tablero.

# NASA FIRMS (focos de calor). Límite: 5.000 transacciones cada 10 minutos.
FIRMS_MAP_KEY=

# Meteomatics (tiempo e índices de riesgo). Cuenta de la oferta del evento, vence el 22/11/2026.
# Límites: 1.000 pedidos por día, 250 por minuto, 10 en paralelo. Solo desde el servidor y con caché.
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Copernicus Data Space, APIs de Sentinel Hub (imagen satelital). Cliente OAuth creado en el Dashboard
# (User Settings > OAuth clients). El secreto se muestra una sola vez. Solo desde el servidor.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Modelo de lenguaje (NVIDIA NIM, compatible con la API de OpenAI)
NVIDIA_API_KEY=

# Bot de Telegram para los avisos (services/alertas). TELEGRAM_ZONAS es un JSON {zona: grupo} con el grupo de cada
# zona de services/alertas/src/alertas/zona.py (D-39). Sin él, la zona de demostración va al grupo de TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ZONAS=

# Token de servicio entre la API y el servicio de avisos (Authorization: Bearer). Mismo valor en los dos.
# Se genera una vez (p. ej. `python -c "import secrets; print(secrets.token_urlsafe(32))"`) y se pasa por privado.
CHARMY_SERVICE_TOKEN=

# Servicio de predicción por zona (services/prediccion, D-40). Solo la API lo llama, con el token por Bearer.
# El token lo genera el dueño del servicio y se pasa por privado; mismo valor en el servicio y en la API.
PREDICCION_URL=
PREDICCION_TOKEN=

# Base de datos de reportes. Con `docker compose up` la base local es:
# postgresql://charmy:charmy-local@localhost:5432/charmy
DATABASE_URL=

# Direcciones públicas (no son secretos). Las de VITE_ las leen los frontends al compilar.
# Mientras la API real no esté, VITE_API_URL apunta al mock de Postman (ver packages/contracts/api/).
VITE_API_URL=
# Manifiesto de los datos precalculados que lee la API (ver infra/README.md). No es secreto.
DATA_MANIFEST_URL=https://github.com/cosmosnehu77/Charmy/releases/download/datos-muestras-2/manifest.json
CHARMY_API_URL=http://localhost:8000
# Orígenes de los frontends publicados que puede llamar la API, separados por coma. Localhost se permite siempre.
CORS_ORIGINS=https://charmy.earth,https://www.charmy.earth,https://app.charmy.earth,https://juego.charmy.earth,https://charmy-app.pages.dev,https://charmy-landing.pages.dev,https://charmy-juego.pages.dev

# Servicio de predicción por zona (services/prediccion, #336). MODELO_URL es la dirección de modelo.json en el
# Release del modelo y MODELO_SHA256 su SHA-256 (están en las notas del Release). PREDICCION_TOKEN es el token
# de servicio con que la API lo llama (Authorization: Bearer): se genera una vez y se pasa por privado.
MODELO_URL=
MODELO_SHA256=
PREDICCION_TOKEN=
