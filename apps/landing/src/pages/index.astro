---
import { charmySvg } from "@charmy/charmy/core";
import iconos from "../data/iconos.json";
import { barrasExperto, curvaNovato, graficoEmpalme } from "../scripts/graficos";
import "../styles/global.css";
import "../styles/landing.css";

// Dominios por defecto de Cloudflare Pages (deploy-web.yml: proyectos charmy-app y charmy-juego).
const URL_APP = "https://app.charmy.earth";
const URL_JUEGO = "https://juego.charmy.earth";
const URL_METODO = "https://github.com/cosmosnehu77/Charmy/blob/main/docs/metodologia/README.md";

// Charmy guía: un dibujo por paso del recorrido, siempre desde el componente (nunca un SVG copiado).
const guion = [
  { mood: "saluda", outfit: "base" },
  { mood: "pensando", outfit: "guia" },
  { mood: "explica", outfit: "guia" },
  { mood: "explica", outfit: "guia" },
  { mood: "explica", outfit: "guia" },
  { mood: "alerta", outfit: "guia" },
  { mood: "saluda", outfit: "bombero" },
] as const;
const figurasGuia = guion.map((g) => charmySvg({ ...g, size: 160, decorative: true }));
const insignia = charmySvg({ mood: "idle", size: 30, variant: "cabeza", animate: false, decorative: true });

const flecha = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 2.5l5 4.5-5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const equipo = [
  { nombre: "Nehuén", login: "cosmosnehu77" },
  { nombre: "Leonel", login: "leonelcnr" },
  { nombre: "Bruno", login: "BrunoAguinaga0" },
  { nombre: "Daniel", login: "daniace" },
  { nombre: "Angelo", login: "dimidio6" },
];

// Agradecimientos: una card por persona, con la foto que pasó el equipo.
const gracias = [
  { nombre: "Walter Sánchez", foto: "walter-sanchez", alt: "Walter Sánchez junto al equipo de Charmy" },
  { nombre: "Debora Reitovich", foto: "debora-reitovich", alt: "Debora Reitovich junto al equipo de Charmy" },
  { nombre: "Franco García", foto: "franco-garcia", alt: "Franco García" },
  { nombre: "Brian Rodríguez", foto: "brian-rodriguez", alt: "Brian Rodríguez junto al equipo de Charmy" },
  { nombre: "El equipo de Charmy", foto: "equipo", alt: "Los cinco integrantes del equipo de Charmy" },
];
const medioGracias = (gracias.length - 1) / 2;

// Logos de Simple Icons (CC0), en el color de cada marca: son logos, no colores del tema.
const herramientas = [
  { nombre: "Python", icono: "python", color: "#3776AB" },
  { nombre: "Polars", icono: "polars", color: "#CD792C" },
  { nombre: "DuckDB", icono: "duckdb", color: "#1B1B1B" },
  { nombre: "PostgreSQL", icono: "postgresql", color: "#4169E1" },
  { nombre: "Docker", icono: "docker", color: "#2496ED" },
  { nombre: "React", icono: "react", color: "#087EA4" },
  { nombre: "TypeScript", icono: "typescript", color: "#3178C6" },
  { nombre: "MapLibre", icono: "maplibre", color: "#396CB2" },
  { nombre: "Astro", icono: "astro", color: "#BC52EE" },
  { nombre: "Telegram", icono: "telegram", color: "#26A5E4" },
] as const;

const instituciones = [
  { logo: "/logos/nasa.svg", alt: "NASA", alto: 86 },
  { logo: "/logos/invap.png", alt: "INVAP", alto: 44 },
  { logo: "/logos/cc.png", alt: "Comodoro Conocimiento, agencia de desarrollo económico", alto: 96 },
];
// El carrusel repite la tira para girar sin cortes; la copia queda oculta a lectores de pantalla.
const tira = [...instituciones, ...instituciones];
---

<!doctype html>
<html lang="es" data-tema="claro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Charmy · Cuando nuestro sur está en peligro</title>
    <meta
      name="description"
      content="Focos de calor de MODIS y VIIRS armonizados desde 2001, como calendario de quema sobre un mapa."
    />
    <script is:inline>
      // Tema guardado o el del sistema, antes de pintar, para que no parpadee.
      try {
        const t = localStorage.getItem("charmy-tema");
        document.documentElement.dataset.tema =
          t === "oscuro" || t === "claro" ? t : matchMedia("(prefers-color-scheme: dark)").matches ? "oscuro" : "claro";
      } catch (e) {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <canvas id="mapa" aria-hidden="true"></canvas>
    <div class="velo"></div>

    <header class="nav">
      <div class="nav-in">
        <a class="marca" href={URL_APP}><span class="insignia" set:html={insignia} />Charmy</a>
        <div class="nav-acc">
          <button type="button" class="nav-btn" id="btn-tema" aria-label="Cambiar a tema oscuro">
            <svg class="i-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></svg>
            <svg class="i-luna" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
          </button>
          <button type="button" class="nav-btn idioma" id="btn-idioma" aria-label="Switch to English">
            <span data-l="es" class="on">ES</span><span data-l="en">EN</span>
          </button>
        </div>
      </div>
    </header>

    <div class="hud-anio" id="hud" aria-hidden="true"><b id="hud-anio">2001</b><span id="hud-sensor">MODIS</span></div>

    <aside class="guia portada-g" id="guia" aria-live="polite">
      <div class="globo" id="guia-globo">¡Hola! Soy Charmy. Te muestro cuándo y dónde se quema el sur.</div>
      <div class="figura" id="guia-figura"></div>
    </aside>
    {figurasGuia.map((svg, i) => <template id={`charmy-${i}`} set:html={svg} />)}

    <main>
      <section class="paso portada" id="portada" data-paso="0" aria-labelledby="titulo">
        <h1 id="titulo">Cuando nuestro sur está en <em>peligro.</em></h1>
        <p class="bajada">Más de veinte años de focos de calor vistos desde el espacio, en un solo mapa.</p>
        <div class="acciones">
          <a class="boton" href={URL_APP}>Abrir la app <Fragment set:html={flecha} /></a>
          <a class="enlace" data-juego href={URL_JUEGO}>Jugar a Charmy Brigada</a>
        </div>
        <div class="desliza" aria-hidden="true"><i></i>Bajá para recorrer el mapa</div>
      </section>

      <section class="paso" id="problema" data-paso="1" aria-labelledby="titulo-problema">
        <div class="paso-in">
          <article class="tarjeta">
            <span class="eti-paso"><b>1</b>de 5 · <u>El problema</u></span>
            <h2 id="titulo-problema">Cambió el satélite, <em>no el fuego.</em></h2>
            <p>En 2012 llegó VIIRS, que ve focos más chicos y por eso cuenta más.</p>
            <div class="grafico" id="grafico" set:html={graficoEmpalme()} />
          </article>
        </div>
      </section>

      <section class="paso" id="armonizacion" data-paso="2" aria-labelledby="titulo-armonizacion">
        <div class="paso-in">
          <article class="tarjeta">
            <span class="eti-paso"><b>2</b>de 5 · <u>La armonización</u></span>
            <h2 id="titulo-armonizacion">Dos satélites, <em>una sola medida.</em></h2>
            <p>Charmy pone las dos series en la misma escala, por región y por mes.</p>
            <dl class="cifras">
              <div><dt>MODIS ↔ S-NPP</dt><dd>0,90</dd></div>
              <div><dt>NOAA-20 ↔ S-NPP</dt><dd>0,94</dd></div>
              <div><dt>Celda</dt><dd>11<small>km</small></dd></div>
            </dl>
            <p class="pie-cifras">r² mensual entre satélites · unidad: día-celda</p>
            <a class="enlace" href={URL_METODO}>Leer el documento del método</a>
          </article>
        </div>
      </section>

      <section class="paso" id="zona" data-paso="3" aria-labelledby="titulo-zona">
        <div class="paso-in">
          <article class="tarjeta">
            <span class="eti-paso"><b>3</b>de 5 · <u>Tu zona</u></span>
            <h2 id="titulo-zona">Dibujás tu zona y <em>el mapa responde.</em></h2>
            <p>Marcás un área o escribís latitud y longitud.</p>
            <div class="coords">
              <span class="campo">Latitud<output>−45,86</output></span>
              <span class="campo">Longitud<output>−67,48</output></span>
            </div>
            <div class="zona-dato"><b id="zona-total">—</b><span>focos de ejemplo en Chubut desde 2001, alrededor de Comodoro Rivadavia</span></div>
          </article>
        </div>
      </section>

      <section class="paso" id="calendario" data-paso="4" aria-labelledby="titulo-calendario">
        <div class="paso-in">
          <article class="tarjeta">
            <span class="eti-paso"><b>4</b>de 5 · <u>Calendario de quema</u></span>
            <h2 id="titulo-calendario">Cada foco vuelve <em>a su mes.</em></h2>
            <p>Mes por mes y año por año: cuánto fuego hubo y si este mes está por encima de lo normal.</p>
            <div class="rampa" aria-hidden="true">
              {[1, 2, 3, 4, 5, 6, 7].map((n) => <i style={`background:var(--rampa-conteo-${n})`}></i>)}
            </div>
            <div class="rampa-txt"><span>menos fuego</span><span>más fuego</span></div>
          </article>
        </div>
      </section>

      <section class="paso" id="vivo" data-paso="5" aria-labelledby="titulo-vivo">
        <div class="paso-in">
          <article class="tarjeta">
            <span class="eti-paso"><b>5</b>de 5 · <u>En vivo</u></span>
            <h2 id="titulo-vivo">Lo que pasó <em>en las últimas horas.</em></h2>
            <p>Los focos recientes de NOAA-20 y NOAA-21.</p>
            <ul class="vivo">
              <li><span class="pulso" aria-hidden="true"></span><span><b>Maule</b>, Chile</span><time>NOAA-21 · hace 2 h</time></li>
              <li><span class="pulso" aria-hidden="true"></span><span><b>Neuquén</b>, Argentina</span><time>NOAA-20 · hace 4 h</time></li>
              <li><span class="pulso" aria-hidden="true"></span><span><b>Chubut</b>, Argentina</span><time>NOAA-21 · hace 5 h</time></li>
            </ul>
            <span class="ejemplo">Ejemplo</span>
          </article>
        </div>
      </section>

      <div class="paso" data-paso="6" style="min-height:60vh"></div>
    </main>

    <div class="resto">
      <div class="envuelve">
        <section id="modos" aria-labelledby="titulo-modos">
          <h2 class="titular" id="titulo-modos">Una respuesta clara, <em>o todos los datos.</em></h2>
          <p class="subtitular">El mismo mapa sirve a quien quiere saber si su zona está bien, a quien necesita validar la serie y a quien viene a jugar.</p>
          <div class="modos">
            <article class="modo n">
              <div class="modo-txt">
                <span class="eti">01 <i>·</i> Modo novato</span>
                <h3>Charmy te lo dice simple.</h3>
                <p>Elegís tu zona y Charmy compara este mes con lo normal. Sin jerga: más fuego, menos o como siempre.</p>
              </div>
              <div class="escena" aria-hidden="true">
                <svg class="malla" viewBox="0 0 620 620"><circle cx="310" cy="310" r="300" /><circle cx="310" cy="310" r="230" /><circle cx="310" cy="310" r="160" /><circle cx="310" cy="310" r="90" /></svg>
                <div class="pila">
                  <div class="lectura atras l3"><span>Enero · Comodoro Rivadavia</span><b>9 días</b></div>
                  <div class="lectura atras l2"><span>Febrero · Comodoro Rivadavia</span><b>12 días</b></div>
                  <div class="lectura l1">
                    <div class="l1-cab"><span class="avatar" set:html={insignia} /><div><strong>Comodoro Rivadavia</strong><span>Marzo</span></div><small>Ejemplo</small></div>
                    <div class="l1-cifra"><b>14</b><span>días con fuego</span><span class="chip">Más fuego que lo normal</span></div>
                    <Fragment set:html={curvaNovato()} />
                    <div class="leyenda"><span><i></i>Este año</span><span><i class="p"></i>Lo normal · 6 días</span></div>
                  </div>
                </div>
              </div>
            </article>

            <article class="modo x">
              <div class="modo-txt">
                <span class="eti">02 <i>·</i> Modo experto</span>
                <h3>Todos los datos, en CSV.</h3>
                <p>La serie armonizada de MODIS y VIIRS, por celda y por mes. Ves lo mismo que bajás y lo validás por tu cuenta.</p>
                <div class="datos"><span>Celda <b>0,1°</b></span><span>Desde <b>2001</b></span><span>Sensores <b>MODIS · VIIRS</b></span></div>
              </div>
              <div class="escena">
                <div class="consola">
                  <div class="c-cab"><h4>Días con fuego</h4><div class="sel"><span><i>Año</i>2019</span><span><i>Celda</i>-67.45_-45.85</span></div></div>
                  <div class="corch"><span>Total <b>30</b></span><span>Pico <b>Feb · 6</b></span><span>Meses sin fuego <b>4</b></span></div>
                  <div class="barras" set:html={barrasExperto()} />
                  <div class="csv" aria-label="Muestra del CSV">
                    <div><span>cell_id</span><span>month</span><span>fire_days</span></div>
                    <div><span>-67.45_-45.85</span><span>2019-01</span><span>4</span></div>
                    <div><span>-67.45_-45.85</span><span>2019-02</span><span>6</span></div>
                    <div><span>-67.55_-45.75</span><span>2019-02</span><span>3</span></div>
                    <div class="cursor">charmy_calendario.csv</div>
                  </div>
                </div>
                <span class="esq a"></span><span class="esq b"></span><span class="esq c"></span><span class="esq d"></span>
              </div>
            </article>
          </div>
        </section>

        <section class="modo j" id="juego" aria-labelledby="titulo-juego">
          <div class="modo-txt">
            <span class="eti">03 <i>·</i> Charmy Brigada</span>
            <h2 id="titulo-juego">Apagá los focos con Charmy.</h2>
            <p>Un juego para chicas y chicos sobre una maqueta en relieve de Sudamérica. El satélite pasa, aparecen focos y los apagás con agua, aviones y brigadas antes de que el viento los corra.</p>
            <a class="boton" data-juego href={URL_JUEGO}>Jugar <Fragment set:html={flecha} /></a>
          </div>
          <div class="escena">
            <a class="captura" data-juego href={URL_JUEGO}><img src="/juego/partida.jpg" width="1120" height="673" loading="lazy" alt="Charmy Brigada en partida: la maqueta de Sudamérica en relieve, la barrida del satélite, focos encendidos y Charmy bombero" /></a>
          </div>
        </section>

        <section class="logos" aria-label="Instituciones">
          <div class="logos-pista">
            <ul class="logos-fila">
              {tira.map((l) => <li><img src={l.logo} alt={l.alt} height={l.alto} style={`height:${l.alto}px`} /></li>)}
            </ul>
            <ul class="logos-fila" aria-hidden="true">
              {tira.map((l) => <li><img src={l.logo} alt="" height={l.alto} style={`height:${l.alto}px`} /></li>)}
            </ul>
          </div>
        </section>

        <section class="equipo-sec" id="nosotros" aria-labelledby="titulo-nosotros">
          <h2 id="titulo-nosotros">Nosotros</h2>
          <div class="nos-grilla">
            <div class="tecno">
              <h3>Tecnologías que usamos</h3>
              <h4 class="nos-mini">Modelos entrenados</h4>
              <ul class="modelos">
                <li>
                  <div class="mod-img">
                    <svg viewBox="0 0 160 70" aria-hidden="true"><path d="M6 58 L30 54 L54 56 L76 50" fill="none" stroke="var(--l-tenue)" stroke-width="2.5" stroke-dasharray="5 4"></path><path d="M76 22 L98 16 L120 24 L154 12" fill="none" stroke="var(--l-tenue)" stroke-width="2.5" stroke-dasharray="5 4"></path><path d="M6 30 L30 22 L54 28 L76 20 L98 16 L120 24 L154 12" fill="none" stroke="var(--l-ambar-txt)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path><line x1="76" y1="6" x2="76" y2="64" stroke="var(--l-tenue)" stroke-width="1"></line></svg>
                  </div>
                  <b>Armoniza MODIS y VIIRS</b>
                </li>
                <li>
                  <div class="mod-img"><img src="/logos/lightgbm.svg" alt="LightGBM" /></div>
                  <b>LightGBM pronostica el fuego</b>
                </li>
                <li>
                  <div class="mod-img">
                    <svg viewBox="0 0 160 70" aria-hidden="true"><path d="M104 30 L154 14 L154 50 L104 42 Z" fill="var(--l-ambar-txt)" fill-opacity=".16"></path><path d="M6 48 L20 40 L34 46 L48 30 L62 38 L76 26 L90 34 L104 36" fill="none" stroke="var(--l-titulo)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path><path d="M104 36 L120 30 L136 34 L154 30" fill="none" stroke="var(--l-ambar-txt)" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 5"></path><line x1="104" y1="6" x2="104" y2="64" stroke="var(--l-tenue)" stroke-width="1"></line></svg>
                  </div>
                  <b>TimesFM, en evaluación</b>
                </li>
                <li>
                  <div class="mod-img"><svg viewBox="0 0 24 24" role="img" aria-label="NVIDIA" class="nv"><path d={iconos.nvidia}></path></svg></div>
                  <b>NIM etiqueta noticias</b>
                </li>
              </ul>
              <h4 class="nos-mini">Herramientas</h4>
              <ul class="tecno-logos">
                {
                  herramientas.map((h) => (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true" style={`color:${h.color}`}><path d={iconos[h.icono]} /></svg>
                      <span>{h.nombre}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="nos-equipo">
              <h3>Quiénes somos</h3>
              <ul class="equipo">
                {
                  equipo.map((p) => (
                    <li>
                      <a href={`https://github.com/${p.login}`}>
                        <img src={`/equipo/${p.login}.jpg`} alt="" width="48" height="48" loading="lazy" />
                        <b>{p.nombre}</b>
                        <code>@{p.login}</code>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>

        <section class="gracias" id="gracias" aria-labelledby="titulo-gracias">
          <span class="eti">Agradecimientos</span>
          <h2 id="titulo-gracias">Gracias a quienes <em>nos acompañaron.</em></h2>
          <p>Charmy salió adelante con ayuda. Pasá el cursor para ver a cada persona.</p>
          <button type="button" class="abrir" aria-expanded="false" aria-controls="abanico">
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <span class="ver">Ver a todos</span><span class="cerrar">Cerrar</span>
          </button>
          <div class="abanico" id="abanico">
            {
              gracias.map((p, i) => (
                <article class="persona" tabindex="0" style={`--d:${i - medioGracias};--a:${Math.abs(i - medioGracias)}`}>
                  <img src={`/gracias/${p.foto}.webp`} alt={p.alt} width="660" height="924" loading="lazy" />
                  <strong>{p.nombre}</strong>
                </article>
              ))
            }
          </div>
        </section>

        <footer class="pie" id="creditos" aria-labelledby="titulo-creditos">
          <h2 class="solo-lectores" id="titulo-creditos">Créditos de los datos</h2>
          <div class="creditos">
            <div><h3>Focos</h3><p><a href="https://firms.modaps.eosdis.nasa.gov/">NASA FIRMS</a></p><p>MODIS y VIIRS (S-NPP, NOAA-20 y NOAA-21).</p></div>
            <div><h3>Imágenes</h3><p><a href="https://dataspace.copernicus.eu/">Copernicus Data Space Ecosystem</a></p><p>Contiene datos modificados de Copernicus Sentinel.</p></div>
            <div><h3>Tiempo</h3><p><a href="https://www.meteomatics.com/">Meteomatics</a></p><p>Viento, temperatura, humedad e índices de riesgo.</p></div>
            <div><h3>Método</h3><p>Cómo se arma la serie, cómo se valida y sus límites: <a href={URL_METODO}>documento del método</a>.</p></div>
          </div>
          <p class="aviso">Charmy no reemplaza a los servicios de emergencia. Si ves un incendio, llamá a los bomberos: <b>100</b> en Argentina, <b>132</b> en Chile.</p>
          <div class="firma">
            <span>Desafío "Harmonization of MODIS and VIIRS Hot Spots", propuesto por CONAE para NASA Space Apps Challenge 2026.</span>
            <span>El mapa de esta página es ilustrativo.</span>
          </div>
        </footer>
      </div>
    </div>

    <script>
      import "../scripts/landing";
    </script>
  </body>
</html>
