{
  "name": "charmy",
  "private": true,
  "description": "Monorepo de Charmy: focos de calor MODIS y VIIRS armonizados.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
