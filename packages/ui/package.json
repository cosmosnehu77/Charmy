{
  "name": "@charmy/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Tokens de diseño de Charmy: paleta, tipografías y rampas de color aptas para daltonismo.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "theme.css",
    "fonts.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "5.1.0"
  }
}
